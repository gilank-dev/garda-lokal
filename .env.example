# --- [4] VPS BARE-METAL INTERNAL (Port 4000) ---
PORT=4000
ROUTER_URL=http://127.0.0.1:20128/v1/chat/completions
ROUTER_MODEL=gemini/gemini-3.5-flash-lite
ROUTER_API_KEY=tugaspai

