# --- [2] ADMIN DASHBOARD SECURITY ---
# Kode rahasia otorisasi tambahan saat petugas login di /admin/login
ADMIN_ACCESS_CODE=GARDA-KOMANDO-2026-RAHASIA

# --- [3] VPS QUEUE WORKER & HMAC SECURITY ---
# Kunci rahasia bersama untuk menandatangani Webhook Vercel -> VPS (HMAC-SHA256)
SHARED_VPS_SECRET=garda_secret_2026_dev
# URL endpoint VPS Worker (Bisa via Cloudflare Tunnel atau IP langsung)
