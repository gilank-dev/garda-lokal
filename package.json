{
  "name": "garda-lokal-pai-platform",
  "version": "1.0.0",
  "private": true,
  "description": "GARDA-LOKAL / PAI (Platform Pelaporan & Intelijen Kejadian Nasional)",
  "workspaces": [
    "apps/*",
    "vps-worker"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "start:web": "npm --prefix apps/web run start",
    "vps:deploy": "python scripts/deploy_vps_worker.py",
    "vps:test-webhook": "python scripts/test_queue_webhook.py",
    "vps:test-rate-limit": "python scripts/test_rate_limit.py"
  }
}
